# Discord bot token (required). Get it from the Discord Developer Portal > your app > Bot > Reset Token.
DISCORD_TOKEN=your-bot-token-here

# Optional: a default guild (server) id so inspection tools can omit the guildId argument.
# Leave empty to always pass guildId explicitly.
DISCORD_GUILD_ID=

# Optional: log level (debug | info | warn | error). Defaults to info.
LOG_LEVEL=info
